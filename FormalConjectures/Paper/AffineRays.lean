/-!
# Challenge statement: eventual periodicity on convex lattice-face families (Theorem 1a)

Written by Claude (coordinator) on 2026-10-20, before any proof, as a short specification in
the style of a Comparator "challenge". It contains one `sorry`: the statement to be proved
elsewhere. Only Mathlib is imported.

Reading guide (everything a human must check is in this file):
1. `Aff`        : an integer affine function `t ↦ a t + b` of the ray parameter `t : ℕ`.
2. `Chart`      : a convex lattice polygon whose sides lie in the six lattice directions,
                  given as the intersection of three strips
                  `lx ≤ x ≤ ux`, `ly ≤ y ≤ uy`, `ls ≤ x + y ≤ us`, with affine bounds.
3. `Sig`        : a fixed finite family of charts, fixed gluing records
                  (`z ↦ rot^j z + d(t)` from one chart to another), and fixed marked corners.
4. `Site`       : a chart together with a lattice point of it (at parameter `t`).
5. `SamePoint`  : a gluing record carries one site to another.
6. `Vertex`     : sites modulo the equivalence generated by `SamePoint`.
7. `graph`      : two vertices are adjacent when representatives in one common chart differ
                  by one of the six unit vectors (sides lie on lattice lines, so every unit
                  triangle lies inside one chart).
8. `Valid`      : what is assumed about the surface at parameter `t`: every edge has exactly
                  two common neighbours (true for fullerene duals: every 3-cycle is a face),
                  each chart is embedded, all degrees are 5 or 6, and every degree-five vertex
                  is a marked corner.
   `TrianglesInCharts` : every triangle of the graph is a unit lattice triangle of one chart
                  (the charts cover the surface and every 3-cycle is a face). Added in version 2
                  (2026-10-20): without it a fixed triangle could be left uncovered by charts.
9. `LiteralPath`: Definition 1(a) of Bille–Buchstaber–Spodarev, literal reading
                  (the same definition as in the first paper's challenge).
10. `main`      : if `Valid` and `TrianglesInCharts` hold for all large `t`, path existence is
                  eventually periodic.

The paper's Theorem 1a assumes a valid simple fullerene dual with an embedded convex
six-direction decomposition. Those assumptions imply `Valid` and `TrianglesInCharts` (both use
the known fact that every 3-cycle of a fullerene dual is facial; the second also uses that the
charts cover the sphere), so this statement implies the paper's theorem. It is stated for one affine family; the paper's variant with finitely many
residue classes follows by applying it to each class.
-/

namespace ClaudeChallenge2

/-- The 60° rotation of the triangular lattice in the basis (1,0), (0,1) = rot (1,0). -/
def rot (z : ℤ × ℤ) : ℤ × ℤ := (-z.2, z.1 + z.2)

/-- `rot` applied `n` times. -/
def rotN : ℕ → ℤ × ℤ → ℤ × ℤ
  | 0, z => z
  | n + 1, z => rot (rotN n z)

/-- The six unit vectors of the triangular lattice. -/
def unitVec : List (ℤ × ℤ) := [(1, 0), (0, 1), (-1, 1), (-1, 0), (0, -1), (1, -1)]

/-- An integer affine function of the ray parameter. -/
structure Aff where
  a : ℤ
  b : ℤ

/-- Value of an affine function at `t`. -/
def Aff.eval (A : Aff) (t : ℕ) : ℤ := A.a * t + A.b

/-- A convex lattice polygon with sides in the six lattice directions. -/
structure Chart where
  lx : Aff
  ux : Aff
  ly : Aff
  uy : Aff
  ls : Aff
  us : Aff

/-- `z` lies in the closed chart at parameter `t`. -/
def Chart.Mem (c : Chart) (t : ℕ) (z : ℤ × ℤ) : Prop :=
  c.lx.eval t ≤ z.1 ∧ z.1 ≤ c.ux.eval t ∧
    c.ly.eval t ≤ z.2 ∧ z.2 ≤ c.uy.eval t ∧
      c.ls.eval t ≤ z.1 + z.2 ∧ z.1 + z.2 ≤ c.us.eval t

/-- A signature: fixed charts, fixed gluing records, fixed marked corners. -/
structure Sig where
  /-- number of charts -/
  C : ℕ
  chart : Fin C → Chart
  /-- number of gluing records -/
  R : ℕ
  src : Fin R → Fin C
  tgt : Fin R → Fin C
  /-- rotation exponent of each record -/
  rotj : Fin R → ℕ
  /-- translation of each record -/
  dx : Fin R → Aff
  dy : Fin R → Aff
  /-- number of marked corners -/
  M : ℕ
  mchart : Fin M → Fin C
  mx : Fin M → Aff
  my : Fin M → Aff

/-- A site at parameter `t`: a chart and a lattice point of it. -/
abbrev Site (S : Sig) (t : ℕ) : Type :=
  {p : Fin S.C × (ℤ × ℤ) // (S.chart p.1).Mem t p.2}

/-- One gluing step: record `r` carries site `s` (in chart `src r`) to site `s'`
(in chart `tgt r`). -/
def SamePoint (S : Sig) (t : ℕ) (s s' : Site S t) : Prop :=
  ∃ r : Fin S.R, s.1.1 = S.src r ∧ s'.1.1 = S.tgt r ∧
    rotN (S.rotj r) s.1.2 + ((S.dx r).eval t, (S.dy r).eval t) = s'.1.2

/-- Vertices of the surface at parameter `t`. -/
abbrev Vertex (S : Sig) (t : ℕ) : Type := Quot (Relation.EqvGen (SamePoint S t))

/-- The vertex of a site. -/
def vtx {S : Sig} {t : ℕ} (s : Site S t) : Vertex S t := Quot.mk _ s

/-- One-sided adjacency: representatives in one common chart differ by a unit vector. -/
def AdjRaw (S : Sig) (t : ℕ) (v w : Vertex S t) : Prop :=
  ∃ s s' : Site S t, vtx s = v ∧ vtx s' = w ∧ s.1.1 = s'.1.1 ∧
    ∃ u ∈ unitVec, s'.1.2 = s.1.2 + u

/-- The surface graph at parameter `t`. -/
def graph (S : Sig) (t : ℕ) : SimpleGraph (Vertex S t) where
  Adj v w := v ≠ w ∧ (AdjRaw S t v w ∨ AdjRaw S t w v)
  symm := ⟨fun _ _ h => ⟨h.1.symm, h.2.symm⟩⟩
  loopless := ⟨fun _ h => h.1 rfl⟩

/-- Degree, as the cardinality of the neighbour set. -/
noncomputable def deg {V : Type} (G : SimpleGraph V) (v : V) : ℕ := (G.neighborSet v).ncard

/-- Every edge has exactly two common neighbours. -/
def TwoCommonNeighbors {V : Type} (G : SimpleGraph V) : Prop :=
  ∀ b c, G.Adj b c → ∃ x y, x ≠ y ∧ ∀ v, (G.Adj b v ∧ G.Adj c v) ↔ (v = x ∨ v = y)

/-- `v` is (the vertex of) a marked corner at parameter `t`. -/
def IsMarked (S : Sig) (t : ℕ) (v : Vertex S t) : Prop :=
  ∃ m : Fin S.M, ∃ h : (S.chart (S.mchart m)).Mem t ((S.mx m).eval t, (S.my m).eval t),
    vtx ⟨(S.mchart m, ((S.mx m).eval t, (S.my m).eval t)), h⟩ = v

/-- The assumptions on the surface at parameter `t`. -/
def Valid (S : Sig) (t : ℕ) : Prop :=
  TwoCommonNeighbors (graph S t) ∧
    (∀ f : Fin S.C, ∀ z z' : ℤ × ℤ, ∀ (h : (S.chart f).Mem t z) (h' : (S.chart f).Mem t z'),
      vtx (S := S) (t := t) ⟨(f, z), h⟩ = vtx ⟨(f, z'), h'⟩ → z = z') ∧
    (∀ v : Vertex S t, deg (graph S t) v = 5 ∨ deg (graph S t) v = 6) ∧
    (∀ v : Vertex S t, deg (graph S t) v = 5 → IsMarked S t v)

/-- Every triangle of the graph is a unit lattice triangle inside one chart. -/
def TrianglesInCharts (S : Sig) (t : ℕ) : Prop :=
  ∀ a b c : Vertex S t, (graph S t).Adj a b → (graph S t).Adj a c → (graph S t).Adj b c →
    ∃ f : Fin S.C, ∃ za zb zc : ℤ × ℤ, ∃ (ha : (S.chart f).Mem t za)
      (hb : (S.chart f).Mem t zb) (hc : (S.chart f).Mem t zc),
      vtx (S := S) (t := t) ⟨(f, za), ha⟩ = a ∧ vtx ⟨(f, zb), hb⟩ = b ∧ vtx ⟨(f, zc), hc⟩ = c ∧
        zb - za ∈ unitVec ∧ zc - za ∈ unitVec ∧ zc - zb ∈ unitVec

/-- Literal linear gSW path `p 0, …, p (n-1)` (Definition 1(a) of Bille–Buchstaber–Spodarev):
an even number `n ≥ 4` of distinct vertices, consecutive and distance-two members adjacent,
degree-five ends whose neighbours on the path have degree six. -/
def LiteralPath {V : Type} (G : SimpleGraph V) (n : ℕ) (p : ℕ → V) : Prop :=
  4 ≤ n ∧ Even n ∧
    (∀ i j, i < n → j < n → p i = p j → i = j) ∧
    (∀ i, i + 1 < n → G.Adj (p i) (p (i + 1))) ∧
    (∀ i, i + 2 < n → G.Adj (p i) (p (i + 2))) ∧
    deg G (p 0) = 5 ∧ deg G (p (n - 1)) = 5 ∧
    deg G (p 1) = 6 ∧ deg G (p (n - 2)) = 6

/-- A literal path exists at parameter `t`. -/
def PathExists (S : Sig) (t : ℕ) : Prop := ∃ n p, LiteralPath (graph S t) n p

/-- Theorem 1a: if the surface is valid for all large `t`, literal-path existence is
eventually periodic in `t`. -/
@[category research solved, AMS 5 37 92, formal_proof using lean4 at
  "https://github.com/tkmt-lab/gsw-ray-periodicity/blob/8a53918db58fa6949ce0f868aa8dcb89be3345d5/packet/formal/Formal/Claude3ComparatorSolution.lean#L10"]
theorem main (S : Sig) (t₁ : ℕ) (hval : ∀ t, t₁ ≤ t → Valid S t ∧ TrianglesInCharts S t) :
    ∃ t₀ P : ℕ, 0 < P ∧ ∀ t, t₀ ≤ t → (PathExists S t ↔ PathExists S (t + P)) := by
  sorry

end ClaudeChallenge2
