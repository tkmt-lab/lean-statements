/-!
# Challenge statement: literal gSW paths in the duals of GC(k,l)[C20]

Written by Claude (coordinator) on 2026-10-19 independently of the main team's proofs,
as a short specification in the style of a Comparator "challenge". It contains one
`sorry`: the statement to be proved elsewhere. Nothing here depends on the main team's
Lean library; only Mathlib is imported.

Reading guide (everything a human must check is in this file):
1. `face`      : the 20 oriented faces of the icosahedron on labels 0..11.
2. `corner`    : each face is drawn in the triangular lattice ℤ² with corners
                 0, α = (k,l) and rot α = (-l, k+l); `rot` is the 60° rotation.
3. `Site`      : a face together with a lattice point of its closed triangle.
4. `SamePoint` : two sites are the same point of the surface when a lattice isometry
                 gluing the two faces along a shared edge carries one to the other.
5. `Vertex`    : sites modulo the equivalence generated by `SamePoint`.
                 This is the vertex set of the dual of GC(k,l)[C20].
6. `gcGraph`   : two vertices are adjacent when some representatives differ by one of
                 the six unit vectors, in one chart or after unfolding across an edge.
7. `LiteralPath` : Definition 1(a) of Bille–Buchstaber–Spodarev, literal reading.
8. `criterion` : the two-stage arithmetic rule.
9. `main`      : for k > l > 0, a literal path exists iff the rule holds.
-/

namespace ClaudeChallenge

/-- The 60° rotation of the triangular lattice in the basis (1,0), (0,1)=rot(1,0). -/
def rot (z : ℤ × ℤ) : ℤ × ℤ := (-z.2, z.1 + z.2)

/-- `rot` applied `n` times. -/
def rotN : ℕ → ℤ × ℤ → ℤ × ℤ
  | 0, z => z
  | n + 1, z => rot (rotN n z)

/-- The six unit vectors of the triangular lattice. -/
def unitVec : List (ℤ × ℤ) := [(1, 0), (0, 1), (-1, 1), (-1, 0), (0, -1), (1, -1)]

/-- The 20 faces of the icosahedron, consistently oriented, on labels 0..11
(0 top, 1–5 upper ring, 6–10 lower ring, 11 bottom). -/
def face : Fin 20 → Fin 3 → Fin 12 :=
  ![![0, 1, 2], ![1, 6, 2], ![2, 6, 7], ![11, 7, 6],
    ![0, 2, 3], ![2, 7, 3], ![3, 7, 8], ![11, 8, 7],
    ![0, 3, 4], ![3, 8, 4], ![4, 8, 9], ![11, 9, 8],
    ![0, 4, 5], ![4, 9, 5], ![5, 9, 10], ![11, 10, 9],
    ![0, 5, 1], ![5, 10, 1], ![1, 10, 6], ![11, 6, 10]]

/-- Positions of the three corners of every face's chart. -/
def corner (k l : ℤ) : Fin 3 → ℤ × ℤ := ![(0, 0), (k, l), (-l, k + l)]

/-- `z` lies in the closed chart triangle with corners `corner k l`. -/
def InTri (k l : ℤ) (z : ℤ × ℤ) : Prop :=
  0 ≤ (k + l) * z.1 + l * z.2 ∧ 0 ≤ -l * z.1 + k * z.2 ∧
    k * z.1 + (k + l) * z.2 ≤ k ^ 2 + k * l + l ^ 2

/-- Label `a` sits at position `p` in the chart of face `f`. -/
def CornerAt (k l : ℤ) (f : Fin 20) (a : Fin 12) (p : ℤ × ℤ) : Prop :=
  ∃ i : Fin 3, face f i = a ∧ corner k l i = p

/-- The lattice isometry `z ↦ rotN j z + t` glues face `g` to face `f` along a shared edge:
it carries two distinct shared labels to their positions in `f`. -/
def Glue (k l : ℤ) (g f : Fin 20) (j : ℕ) (t : ℤ × ℤ) : Prop :=
  g ≠ f ∧ ∃ a b : Fin 12, a ≠ b ∧
    ∃ pa pb qa qb : ℤ × ℤ, CornerAt k l g a pa ∧ CornerAt k l g b pb ∧
      CornerAt k l f a qa ∧ CornerAt k l f b qb ∧
      rotN j pa + t = qa ∧ rotN j pb + t = qb

/-- A site: a face and a lattice point of its closed triangle. -/
abbrev Site (k l : ℤ) : Type := {p : Fin 20 × (ℤ × ℤ) // InTri k l p.2}

/-- Two sites are the same point of the surface (one step of the identification). -/
def SamePoint (k l : ℤ) (s s' : Site k l) : Prop :=
  ∃ j t, Glue k l s.1.1 s'.1.1 j t ∧ rotN j s.1.2 + t = s'.1.2

/-- Vertices of the dual of GC(k,l)[C20]. -/
abbrev Vertex (k l : ℤ) : Type := Quot (Relation.EqvGen (SamePoint k l))

/-- The vertex of a site. -/
def vtx {k l : ℤ} (s : Site k l) : Vertex k l := Quot.mk _ s

/-- One-sided adjacency of sites: `s'` is a unit step from `s`, in the same chart or after
unfolding the chart of `s'` onto the chart of `s` across a shared edge. -/
def StepTo (k l : ℤ) (s s' : Site k l) : Prop :=
  ∃ u ∈ unitVec,
    (s'.1.1 = s.1.1 ∧ s'.1.2 = s.1.2 + u) ∨
    (∃ j t, Glue k l s'.1.1 s.1.1 j t ∧ rotN j s'.1.2 + t = s.1.2 + u)

/-- Adjacency of vertices before symmetrising. -/
def AdjRaw (k l : ℤ) (v w : Vertex k l) : Prop :=
  ∃ s s' : Site k l, vtx s = v ∧ vtx s' = w ∧ StepTo k l s s'

/-- The dual graph of GC(k,l)[C20] (a triangulation of the sphere). -/
def gcGraph (k l : ℤ) : SimpleGraph (Vertex k l) where
  Adj v w := v ≠ w ∧ (AdjRaw k l v w ∨ AdjRaw k l w v)
  symm := ⟨fun _ _ h => ⟨h.1.symm, h.2.symm⟩⟩
  loopless := ⟨fun _ h => h.1 rfl⟩

/-- Degree, as the cardinality of the neighbour set (finite for these graphs). -/
noncomputable def deg {V : Type} (G : SimpleGraph V) (v : V) : ℕ := (G.neighborSet v).ncard

/-- Literal linear gSW path `p 0, …, p (n-1)` (Definition 1(a) of Bille–Buchstaber–Spodarev):
an even number `n ≥ 4` of distinct vertices, consecutive and distance-two members adjacent,
degree-five ends whose neighbours on the path have degree six. -/
def LiteralPath {V : Type} (G : SimpleGraph V) (n : ℕ) (p : ℕ → V) : Prop :=
  4 ≤ n ∧ Even n ∧
    (∀ i j, i < n → j < n → p i = p j → i = j) ∧
    (∀ i, i + 1 < n → G.Adj (p i) (p (i + 1))) ∧
    (∀ i, i + 2 < n → G.Adj (p i) (p (i + 2))) ∧
    deg G (p 0) = 5 ∧ deg G (p (n - 1)) = 5 ∧
    deg G (p 1) = 6 ∧ deg G (p (n - 2)) = 6

/-- The two-stage rule. -/
def criterion (k l : ℕ) : Prop :=
  Nat.gcd k l = 1 ∧
    let m := min l (k - l)
    m = 1 ∨
      (2 ≤ m ∧ 3 ≤ k / m ∧ (k % m = 1 ∨ k % m = m - 1)) ∨
      (2 ≤ m ∧ k / m = 2 ∧
        let r := k - 2 * m
        r = 1 ∨ m % r = 1 ∨ m % r = r - 1)

-- Definition-only receipt: the unproved main theorem is deliberately not imported.
/-- Main classification: for `k > l > 0`, the dual of GC(k,l)[C20] has a literal gSW path
iff the two-stage rule holds. -/
@[category research solved, AMS 5 37 92, formal_proof using lean4 at
  "https://github.com/tkmt-lab/a3-gsw-classification/blob/58124b20fa4a3b19aaa62e734c2036210f7bdcf8/packet/formal/Formal/ComparatorSolutionMain.lean#L7"]
theorem main (k l : ℕ) (hl : 0 < l) (hlk : l < k) :
    (∃ n p, LiteralPath (gcGraph k l) n p) ↔ criterion k l := by
  sorry

end ClaudeChallenge
